# OpenSky API
OPENSKY_API_BASE_URL=https://opensky-network.org/api/states/all
OPENSKY_API_USERNAME=
OPENSKY_API_PASSWORD=

# Ingestion settings
POLL_INTERVAL_SECONDS=10
KAFKA_TOPIC_FLIGHT_TELEMETRY=opensky.flight.telemetry.raw
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=skypulse-producer

# Spark / streaming settings
SPARK_APP_NAME=skypulse-streaming
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=./data/checkpoints/skypulse

# Data lake paths (medallion)
BRONZE_PATH=./data/bronze
SILVER_PATH=./data/silver
GOLD_PATH=./data/gold

# Serving layer (PostgreSQL/TimescaleDB compatible)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skypulse
POSTGRES_USER=skypulse
POSTGRES_PASSWORD=skypulse
